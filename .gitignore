# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (database, uploaded files) and test output
/.data/
/test-results/
/playwright-report/
!.env.example

# the iPhone app (ios/): what a build makes, and what signs it. Apple's keys
# never go in the repository.
/ios-shell/dist/
/ios/App/build/
*.xcarchive
*.ipa
*.p8
*.p12
*.mobileprovision
private_keys/
