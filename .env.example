# Copy to .env.local for development. Never commit real values.

# Postgres. In development, `npm run db:start` runs one in .data/pg on this port.
DATABASE_URL=postgres://ead:ead@127.0.0.1:54329/ead

# Signs file links and the first-admin setup link. Any long random string.
APP_SECRET=change-me-to-a-long-random-string

# The code asked once, at /demarrer, to create the office's first account.
# Development uses "dev" when it is not set. Production requires at least 16
# characters and ignores anything shorter (setup then stays closed): generate
# one with `openssl rand -base64 24`, and delete the variable once the
# office's account exists.
# SETUP_CODE=

# Where files are kept: "fs" (a folder, for development only) or "supabase".
# Do not copy these two lines to production: a production server refuses the
# folder on disk, and so does the deployment (unless ALLOW_FS_STORAGE=1, meant
# for a test server such as the end-to-end tests').
STORAGE_DRIVER=fs
STORAGE_DIR=.data/storage

# Production (set by the Supabase integration on Vercel); with them the
# driver is "supabase" without STORAGE_DRIVER:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# The report's assistant (dictation, photos) goes through Vercel AI Gateway
# and needs nothing here on Vercel. Elsewhere, a gateway key:
# AI_GATEWAY_API_KEY=
# Another model of the gateway's catalog than the default, if wanted:
# AI_MODEL=
# Answers by fixed rules and calls no service (the end-to-end tests set it):
# AI_FAKE=1
